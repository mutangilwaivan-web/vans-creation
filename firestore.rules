rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read access for showroom catalog & settings
    match /creations/{creationId} {
      allow read: if true;
      allow update: if isAuthenticated() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'comments']);
      allow create, delete: if isAuthenticated();
    }

    match /inspirations/{inspirationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /occasions/{occasionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true; // Allows clients to submit testimonials
      allow update, delete: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Catch-all default: read allowed, write protected
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
